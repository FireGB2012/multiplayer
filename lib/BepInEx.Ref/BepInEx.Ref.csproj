<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compile-only stand-in for BepInEx 5.4.x, so the mod builds without the game installed.
    Only contains the members the mod uses, with the exact signatures from BepInEx 5.4.23.2.
    It is never shipped: at runtime the real BepInEx.dll in the game folder is used.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BepInEx</AssemblyName>
    <RootNamespace>BepInEx</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AssemblyVersion>5.4.23.2</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
