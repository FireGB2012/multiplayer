<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The launcher app (Windows .exe, Linux AppImage): installs the mod, hosts servers, launches the game.
    Build the single-file exe with:
      dotnet publish src/SubnauticaMP.Launcher -c Release -r win-x64
    Linux: dotnet publish ... -r linux-x64, then tools/appimage/build.sh packs it into an AppImage.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SubnauticaMP-Launcher</AssemblyName>
    <RootNamespace>SubnauticaMP.Launcher</RootNamespace>
    <Version>0.25.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- No compression, no trimming, no unpacking native DLLs to %TEMP% at startup: packed exes that drop files
         look like malware to antivirus guesswork (Wacatac false positives). Bigger download, fewer false alarms.
         The few native DLLs (Skia, HarfBuzz) ship next to the exe instead. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SubnauticaMP.Launcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubnauticaMP.Shared\SubnauticaMP.Shared.csproj" />
    <!-- build the mod first so we can pack it inside the exe -->
    <ProjectReference Include="..\SubnauticaMP.Plugin\SubnauticaMP.Plugin.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=net472"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="..\SubnauticaMP.Optimizer\SubnauticaMP.Optimizer.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=net472"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </ItemGroup>

  <Target Name="EmbedMod" AfterTargets="ResolveProjectReferences">
    <PropertyGroup>
      <ModDll>$(MSBuildThisFileDirectory)..\SubnauticaMP.Plugin\bin\$(Configuration)\SubnauticaMP.dll</ModDll>
    </PropertyGroup>
    <PropertyGroup>
      <OptimizerDll>$(MSBuildThisFileDirectory)..\SubnauticaMP.Optimizer\bin\$(Configuration)\SubnauticaOptimizer.dll</OptimizerDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(ModDll)')" Text="Mod DLL not built: $(ModDll)" />
    <Error Condition="!Exists('$(OptimizerDll)')" Text="Optimizer DLL not built: $(OptimizerDll)" />
    <ItemGroup>
      <EmbeddedResource Include="$(ModDll)" LogicalName="SubnauticaMP.dll" />
      <EmbeddedResource Include="$([System.IO.Path]::GetDirectoryName($(ModDll)))\Mono.Nat.dll" LogicalName="Mono.Nat.dll" />
      <EmbeddedResource Include="$(OptimizerDll)" LogicalName="SubnauticaOptimizer.dll" />
    </ItemGroup>
  </Target>

</Project>
