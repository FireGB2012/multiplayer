<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SubnauticaMP.Launcher.App"
             RequestedThemeVariant="Dark">

  <!-- Subnautica PDA look: electric-blue glowing frame, near-black screen, frosted light-blue panels, white text. -->
  <Application.Resources>
    <SolidColorBrush x:Key="ScreenBrush" Color="#020A1A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#D9214F86" />
    <SolidColorBrush x:Key="PanelEdgeBrush" Color="#5C9FE0" />
    <SolidColorBrush x:Key="GlowBrush" Color="#3B8CFF" />
    <SolidColorBrush x:Key="IceBrush" Color="#BFE2FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#93BCE6" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OkBrush" Color="#6BE39A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFC857" />
    <SolidColorBrush x:Key="BadBrush" Color="#FF7A6B" />

    <!-- Fluent controls in PDA colors -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#1C4A82" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2862A8" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#163D6E" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#132E52" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#BFE2FF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6585AA" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#5C9FE0" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#9AD0FF" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#9AD0FF" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#24466F" />

    <SolidColorBrush x:Key="TextControlBackground" Color="#0B1F3D" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E274B" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0B1F3D" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0D213D" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3E79BD" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5C9FE0" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#9AD0FF" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#24466F" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#93BCE6" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6E93BE" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#7FA3CC" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6E93BE" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#2F7BFF" />

    <SolidColorBrush x:Key="ComboBoxBackground" Color="#0B1F3D" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0E274B" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0B1F3D" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0D213D" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3E79BD" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#5C9FE0" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#9AD0FF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#24466F" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#93BCE6" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#0E274B" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#5C9FE0" />

    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#1C4A82" />
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#2862A8" />
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#2F70BE" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#3B8CFF" RegionColor="#020A1A" ErrorText="#FF7A6B"
                               AltHigh="#020A1A" AltLow="#020A1A" AltMedium="#020A1A" AltMediumHigh="#020A1A" AltMediumLow="#020A1A"
                               BaseHigh="#FFFFFF" BaseLow="#24466F" BaseMedium="#BFE2FF" BaseMediumHigh="#DDEFFF" BaseMediumLow="#93BCE6"
                               ChromeAltLow="#DDEFFF" ChromeBlackHigh="#000000" ChromeBlackLow="#DDEFFF" ChromeBlackMedium="#000000"
                               ChromeBlackMediumLow="#000000" ChromeDisabledHigh="#24466F" ChromeDisabledLow="#6585AA" ChromeGray="#93BCE6"
                               ChromeHigh="#3E79BD" ChromeLow="#0B1F3D" ChromeMedium="#0E274B" ChromeMediumLow="#0B1F3D" ChromeWhite="#FFFFFF"
                               ListLow="#1C4A82" ListMedium="#2862A8" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
      <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    </Style>

    <!-- ===== text ===== -->
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource IceBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.step">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="3" />
    </Style>
    <Style Selector="TextBlock.rowtitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.rowdetail">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource IceBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>
    <!-- on the Home rows the detail line stays light: the dot shows the state -->
    <Style Selector="Border.row TextBlock.rowdetail">
      <Setter Property="Foreground" Value="{StaticResource IceBrush}" />
    </Style>

    <!-- ===== panels (frosted blue, like the PDA's pages) ===== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="#990B1F3D" />
      <Setter Property="BorderBrush" Value="#3E79BD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Home: list rows like the PDA's log, round icon on the left, status dot on the right -->
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="8,8,12,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#33102C55" />
    </Style>
    <Style Selector="Border.bubble">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="#123A6B" />
      <Setter Property="BorderBrush" Value="#9AD0FF" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Path.glyph">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{StaticResource WhiteBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#5E7FA6" />
    </Style>
    <Style Selector="Border.row.ok Ellipse.dot">
      <Setter Property="Fill" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.row.warn Ellipse.dot">
      <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
    </Style>
    <Style Selector="Border.row.bad Ellipse.dot">
      <Setter Property="Fill" Value="{StaticResource BadBrush}" />
    </Style>

    <!-- ===== buttons ===== -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="#BFE2FF" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#5DB3FF" />
          <GradientStop Offset="1" Color="#1767EA" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#86C8FF" />
          <GradientStop Offset="1" Color="#2B7BF5" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1767EA" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#183A66" />
      <Setter Property="Foreground" Value="#6585AA" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="BorderBrush" Value="#99FF7A6B" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
      <Setter Property="Background" Value="#4A2230" />
    </Style>
    <!-- minimize / close in the screen's corner -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="#123A6B" />
    </Style>
    <Style Selector="Button.chrome Path">
      <Setter Property="Stroke" Value="{StaticResource WhiteBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C8453A" />
      <Setter Property="BorderBrush" Value="#FF9A8F" />
    </Style>

    <!-- ===== PDA tabs: a strip across the top of the screen, like the game's PDA ===== -->
    <Style Selector="TabControl.pda">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <Border DockPanel.Dock="Top" HorizontalAlignment="Center" Height="52" Padding="6" CornerRadius="14"
                    Background="#59214F86" BorderBrush="#3E79BD" BorderThickness="1">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
            <ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </DockPanel>
        </ControlTemplate>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.pda > TabItem">
      <Setter Property="Foreground" Value="{StaticResource IceBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="9" Padding="16,0" MinWidth="110">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TabControl.pda > TabItem:pointerover">
      <Setter Property="Background" Value="#2A5A9A" />
      <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    </Style>
    <Style Selector="TabControl.pda > TabItem:selected">
      <Setter Property="Background" Value="#4F95E8" />
      <Setter Property="BorderBrush" Value="#CFE8FF" />
      <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
    </Style>
    <Style Selector="TabControl.pda > TabItem Path.icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{StaticResource IceBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TabControl.pda > TabItem:selected Path.icon">
      <Setter Property="Stroke" Value="{StaticResource WhiteBrush}" />
    </Style>
    <Style Selector="TabControl.pda > TabItem TextBlock.navlabel">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== lists ===== -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Application.Styles>
</Application>
