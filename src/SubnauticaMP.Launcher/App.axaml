<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SubnauticaMP.Launcher.App"
             RequestedThemeVariant="Dark">

  <!-- "Alterra PDA" theme (theme-factory: Ocean Depths + Tech Innovation).
       Abyss background, PDA glass panels, scanner-cyan for the one main action, seafoam labels, cream text. -->
  <Application.Resources>
    <Color x:Key="Abyss">#06111B</Color>
    <Color x:Key="Glass">#0B1E2C</Color>
    <Color x:Key="GlassDeep">#081826</Color>
    <Color x:Key="Edge">#1E5A6E</Color>
    <Color x:Key="Scanner">#3FE0E8</Color>
    <Color x:Key="Teal">#2D8B8B</Color>
    <Color x:Key="Seafoam">#A8DADC</Color>
    <Color x:Key="Cream">#F1FAEE</Color>

    <SolidColorBrush x:Key="AbyssBrush" Color="#06111B" />
    <SolidColorBrush x:Key="GlassBrush" Color="#0B1E2C" />
    <SolidColorBrush x:Key="GlassDeepBrush" Color="#081826" />
    <SolidColorBrush x:Key="EdgeBrush" Color="#1E5A6E" />
    <SolidColorBrush x:Key="ScannerBrush" Color="#3FE0E8" />
    <SolidColorBrush x:Key="TealBrush" Color="#2D8B8B" />
    <SolidColorBrush x:Key="SeafoamBrush" Color="#A8DADC" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6FA9B3" />
    <SolidColorBrush x:Key="CreamBrush" Color="#F1FAEE" />
    <SolidColorBrush x:Key="OkBrush" Color="#5BD68B" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F2C14E" />
    <SolidColorBrush x:Key="BadBrush" Color="#FF7A6B" />

    <!-- Fluent controls in theme colors -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#0E2A3B" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#134056" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0B2232" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0A1A26" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#F1FAEE" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#A8DADC" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#4E6C78" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2D8B8B" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3FE0E8" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#3FE0E8" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#163445" />

    <SolidColorBrush x:Key="TextControlBackground" Color="#081826" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0A1F2F" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#081826" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0A1A26" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1E5A6E" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2D8B8B" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#3FE0E8" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#163445" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#F1FAEE" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F1FAEE" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6FA9B3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5E8A96" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6FA9B3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5E8A96" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#2D8B8B" />

    <SolidColorBrush x:Key="ComboBoxBackground" Color="#081826" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#0A1F2F" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#081826" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0A1A26" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1E5A6E" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#2D8B8B" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#3FE0E8" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#163445" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#6FA9B3" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#0B1E2C" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2D8B8B" />

    <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#0E2A3B" />
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#134056" />
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#17506A" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#3FE0E8" RegionColor="#06111B" ErrorText="#FF7A6B"
                               AltHigh="#06111B" AltLow="#06111B" AltMedium="#06111B" AltMediumHigh="#06111B" AltMediumLow="#06111B"
                               BaseHigh="#F1FAEE" BaseLow="#1E5A6E" BaseMedium="#A8DADC" BaseMediumHigh="#CFEFF0" BaseMediumLow="#6FA9B3"
                               ChromeAltLow="#CFEFF0" ChromeBlackHigh="#000000" ChromeBlackLow="#CFEFF0" ChromeBlackMedium="#000000"
                               ChromeBlackMediumLow="#000000" ChromeDisabledHigh="#1E5A6E" ChromeDisabledLow="#5A7A8A" ChromeGray="#6FA9B3"
                               ChromeHigh="#2D6B7E" ChromeLow="#0B1E2C" ChromeMedium="#0E2536" ChromeMediumLow="#0B1E2C" ChromeWhite="#F1FAEE"
                               ListLow="#0E2A3B" ListMedium="#134056" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
      <Setter Property="Foreground" Value="{StaticResource CreamBrush}" />
    </Style>

    <!-- ===== PDA shell ===== -->
    <Style Selector="Border.shell">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderBrush">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#3FE0E8" />
          <GradientStop Offset="0.35" Color="#1E5A6E" />
          <GradientStop Offset="0.7" Color="#123747" />
          <GradientStop Offset="1" Color="#2D8B8B" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#0A1A27" />
          <GradientStop Offset="1" Color="#07131E" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Path.bracket">
      <Setter Property="Stroke" Value="{StaticResource ScannerBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ===== text ===== -->
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="2.5" />
      <Setter Property="Foreground" Value="{StaticResource SeafoamBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="LineHeight" Value="19" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource SeafoamBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.5" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource ScannerBrush}" />
      <Setter Property="LetterSpacing" Value="3" />
    </Style>
    <Style Selector="TextBlock.step">
      <Setter Property="Foreground" Value="{StaticResource SeafoamBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
    </Style>

    <!-- ===== panels ===== -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#B30B1E2C" />
      <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{StaticResource GlassDeepBrush}" />
      <Setter Property="BorderBrush" Value="#163C4D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- status chips: a dot + a word, colored by state -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="11,5,13,5" />
      <Setter Property="Background" Value="#A6061420" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#2A5566" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#5E8A96" />
    </Style>
    <Style Selector="Border.chip.ok">
      <Setter Property="BorderBrush" Value="#3A5BD68B" />
    </Style>
    <Style Selector="Border.chip.ok Ellipse">
      <Setter Property="Fill" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.chip.warn">
      <Setter Property="BorderBrush" Value="#4DF2C14E" />
    </Style>
    <Style Selector="Border.chip.warn Ellipse">
      <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
    </Style>
    <Style Selector="Border.chip.bad">
      <Setter Property="BorderBrush" Value="#59FF7A6B" />
    </Style>
    <Style Selector="Border.chip.bad Ellipse">
      <Setter Property="Fill" Value="{StaticResource BadBrush}" />
    </Style>

    <!-- ===== buttons ===== -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="#04121C" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#5FF0F5" />
          <GradientStop Offset="1" Color="#1FB6C9" />
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 0 22 0 #593FE0E8" />
      <Setter Property="Transitions">
        <Transitions>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#8AF7FA" />
          <GradientStop Offset="1" Color="#36CADB" />
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Foreground" Value="#04121C" />
      <Setter Property="BoxShadow" Value="0 0 34 2 #8C3FE0E8" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1FB6C9" />
      <Setter Property="Foreground" Value="#04121C" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14313F" />
      <Setter Property="Foreground" Value="#4E6C78" />
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="BorderBrush" Value="#59FF7A6B" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
      <Setter Property="Background" Value="#2A1A1E" />
    </Style>

    <!-- ===== sidebar navigation (a TabControl with its tabs on the left) ===== -->
    <Style Selector="TabControl.nav">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="96,*">
            <Border Background="#66040D15" BorderBrush="#143746" BorderThickness="0,0,1,0">
              <DockPanel>
                <!-- emblem -->
                <Panel DockPanel.Dock="Top" Width="44" Height="44" Margin="0,18,0,18" HorizontalAlignment="Center">
                  <Path Data="M22,1 L40,11.5 L40,32.5 L22,43 L4,32.5 L4,11.5 Z" Stroke="{StaticResource ScannerBrush}" StrokeThickness="1.5"
                        Fill="#1A3FE0E8" />
                  <TextBlock Text="MP" FontWeight="Bold" FontSize="13" LetterSpacing="1" Foreground="{StaticResource ScannerBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </DockPanel>
            </Border>
            <ContentPresenter Grid.Column="1" Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" Spacing="6" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.nav > TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Margin="10,0">
            <Border Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,11,0,9">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Border Name="pipe" Width="3" CornerRadius="2" Margin="-6,14" HorizontalAlignment="Left" Background="Transparent" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabControl.nav > TabItem:pointerover">
      <Setter Property="Background" Value="#0E2A3B" />
      <Setter Property="Foreground" Value="{StaticResource SeafoamBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:selected">
      <Setter Property="Background" Value="#16405A" />
      <Setter Property="Foreground" Value="{StaticResource ScannerBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:selected /template/ Border#pipe">
      <Setter Property="Background" Value="{StaticResource ScannerBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem Path.icon">
      <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:pointerover Path.icon">
      <Setter Property="Stroke" Value="{StaticResource SeafoamBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem:selected Path.icon">
      <Setter Property="Stroke" Value="{StaticResource ScannerBrush}" />
    </Style>
    <Style Selector="TabControl.nav > TabItem TextBlock.navlabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- ===== lists / log ===== -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
  </Application.Styles>
</Application>
