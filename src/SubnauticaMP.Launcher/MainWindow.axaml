<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SubnauticaMP.Launcher.MainWindow"
        Title="Subnautica Multiplayer"
        Icon="/Assets/icon.ico"
        Width="1190" Height="690" CanResize="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        WindowStartupLocation="CenterScreen">

  <!-- The window IS the PDA: a white handle with a rubber grip on the left (drag it to move the window),
       a glowing blue frame and the dark screen. Everything happens on the screen. -->
  <Grid>
    <!-- blue frame -->
    <Border Margin="122,16,16,16" CornerRadius="42" Padding="96,20,20,20" BoxShadow="0 0 26 3 #992F7BFF">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#4AA6FF" />
          <GradientStop Offset="0.5" Color="#1767EA" />
          <GradientStop Offset="1" Color="#0C4FCB" />
        </LinearGradientBrush>
      </Border.Background>

      <!-- screen -->
      <Border Classes="screen" CornerRadius="24" Background="#020A1A" BorderBrush="#86C8FF" BorderThickness="1.5"
              BoxShadow="inset 0 0 44 6 #8C2F7BFF" Padding="20,12,20,12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <TabControl Grid.RowSpan="2" x:Name="Tabs" Classes="pda">

            <!-- ================= HOME ================= -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="M4,11 L12,4 L20,11 V20 H4 Z M10,20 V14.5 H14 V20" />
                  <TextBlock Classes="navlabel" Text="Home" />
                </StackPanel>
              </TabItem.Header>

              <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="6,14,6,4">
                <StackPanel Spacing="2" Margin="2,0,0,14">
                  <TextBlock Text="Subnautica Multiplayer" Classes="title" />
                  <TextBlock Classes="hint" Text="Play the whole game together with your friends." />
                </StackPanel>

                <Grid Grid.Row="1">
                  <Border Classes="card" Padding="8">
                    <StackPanel Spacing="6">
                      <Border x:Name="GameChip" Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Classes="bubble"><Path Classes="glyph" Data="M3,8 H21 V18 H3 Z M7,12 H10 M8.5,10.5 V13.5 M15,12 H15.5 M17.5,13 H18" /></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="2">
                            <TextBlock x:Name="GameChipText" Classes="rowtitle" />
                            <TextBlock x:Name="PlayGameStatus" Classes="rowdetail" />
                          </StackPanel>
                          <Button Grid.Column="2" x:Name="PlayBrowseButton" Content="Browse..." VerticalAlignment="Center" Margin="0,0,12,0" />
                          <Ellipse Grid.Column="3" Classes="dot" />
                        </Grid>
                      </Border>
                      <Border x:Name="ModChip" Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="bubble"><Path Classes="glyph" Data="M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 V21" /></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="2">
                            <TextBlock x:Name="ModChipText" Classes="rowtitle" />
                            <TextBlock Classes="rowdetail" Text="BepInEx, Nautilus, multiplayer and the optimizer" />
                          </StackPanel>
                          <Ellipse Grid.Column="2" Classes="dot" />
                        </Grid>
                      </Border>
                      <Border x:Name="ServerChip" Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="bubble"><Path Classes="glyph" Data="M4,4.5 H20 V10.5 H4 Z M4,13.5 H20 V19.5 H4 Z M7.5,7.5 H8.5 M7.5,16.5 H8.5" /></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="2">
                            <TextBlock x:Name="ServerChipText" Classes="rowtitle" />
                            <TextBlock Classes="rowdetail" Text="Host a world here on the Server tab, or join one in the game" />
                          </StackPanel>
                          <Ellipse Grid.Column="2" Classes="dot" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="*,20,300" Margin="0,14,0,0">
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="label" Text="HOW TO PLAY" />
                      <TextBlock Classes="step" Text="Hit PLAY. The game opens with the mod installed." />
                      <TextBlock Classes="step" Text="In the main menu click Multiplayer, then host a world or add a friend's join code." />
                      <TextBlock Classes="step" Text="In game: Esc › Multiplayer or F8 for chat and players. Hold G for emotes." />
                    </StackPanel>
                  </Border>

                  <Grid Grid.Column="2" RowDefinitions="*,Auto">
                    <Border Classes="glow" CornerRadius="16" Margin="3" BoxShadow="0 0 30 2 #992F7BFF" Background="#1767EA" />
                    <Button x:Name="PlayButton" Classes="primary play" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="96">
                      <TextBlock x:Name="PlayButtonText" Text="PLAY" LetterSpacing="8" Margin="8,0,0,0" />
                    </Button>
                    <TextBlock Grid.Row="1" x:Name="PlayCaption" Classes="hint" TextAlignment="Center" Margin="0,8,0,0"
                               Text="Installs the mod, then starts the game" />
                  </Grid>
                </Grid>
              </Grid>
            </TabItem>

          <!-- ================= SERVER (like Nitrox: list of your servers, create one, open one) ================= -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="M4,4.5 H20 V10.5 H4 Z M4,13.5 H20 V19.5 H4 Z M7.5,7.5 H8.5 M7.5,16.5 H8.5" />
                <TextBlock Classes="navlabel" Text="Server" />
              </StackPanel>
            </TabItem.Header>

            <Panel Margin="6,14,6,4">

              <!-- 1. the list -->
              <Grid x:Name="ServerListView" Classes="view" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Servers" Classes="title" />
                    <TextBlock Classes="hint" Text="Your worlds on this PC. Start one and friends join with its code." />
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="NewServerButton" Classes="primary" Content="+  Create server" VerticalAlignment="Center" Padding="20,11" FontSize="14" />
                </Grid>
                <Panel Grid.Row="1">
                  <ScrollViewer AllowAutoHide="False">
                    <ItemsControl x:Name="ServerItems">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8" Margin="0,0,10,0" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                  <Border x:Name="NoServersCard" Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,18">
                      <TextBlock Text="No servers yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                      <TextBlock Classes="hint" Text="Hit Create server to make your first world." HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Panel>
              </Grid>

              <!-- 2. create a new one -->
              <Grid x:Name="ServerCreateView" Classes="view" RowDefinitions="Auto,Auto,*" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                  <Button x:Name="CreateBackButton" Classes="chrome" VerticalAlignment="Center" ToolTip.Tip="Back"><Path Data="M8,2 L3,6 L8,10" /></Button>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0">
                    <TextBlock Text="Create server" Classes="title" />
                    <TextBlock Classes="hint" Text="A new world. You can start it again any time from the list." />
                  </StackPanel>
                </Grid>
                <Border Grid.Row="1" Classes="card">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="2*,14,*,14,96">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="SERVER NAME" />
                        <TextBox x:Name="WorldBox" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Classes="label" Text="PASSWORD" />
                        <TextBox x:Name="HostPasswordBox" PasswordChar="•" Watermark="optional" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Spacing="6">
                        <TextBlock Classes="label" Text="PORT" />
                        <TextBox x:Name="PortBox" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="label" Text="GAME MODE" />
                      <ComboBox x:Name="ModeBox" Width="260" />
                      <TextBlock x:Name="ModeHint" Classes="hint" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock x:Name="WorldSummary" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" x:Name="CreateServerButton" Classes="primary" Content="CREATE AND START" MinWidth="220" Height="48" FontSize="15" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 3. an open (running) server -->
              <Grid x:Name="ServerRunView" Classes="view" RowDefinitions="Auto,Auto,*" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,12">
                  <StackPanel Spacing="2">
                    <TextBlock x:Name="RunTitle" Classes="title" />
                    <TextBlock x:Name="RunSubtitle" Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="ServerButton" Classes="danger" Content="Stop server" VerticalAlignment="Center" Padding="20,10" FontSize="14" />
                </Grid>

                <Border Grid.Row="1" Classes="card" x:Name="CodesCard">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,28,*,Auto">
                      <StackPanel>
                        <TextBlock Classes="label" Text="JOIN CODE  ·  INTERNET" />
                        <TextBlock x:Name="InternetCodeText" Classes="code" Text="..." />
                      </StackPanel>
                      <Button Grid.Column="1" x:Name="CopyInternetButton" Content="Copy" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Width="1" Background="#5C9FE0" Margin="13,4" />
                      <StackPanel Grid.Column="3">
                        <TextBlock Classes="label" Text="JOIN CODE  ·  SAME WIFI" />
                        <TextBlock x:Name="LanCodeText" Classes="code" FontSize="22" Margin="0,5,0,0" Text="..." />
                      </StackPanel>
                      <Button Grid.Column="4" x:Name="CopyLanButton" Content="Copy" VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="inset">
                      <StackPanel Spacing="5">
                        <TextBlock x:Name="LobbyText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock x:Name="RouterText" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReachText" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <WrapPanel>
                      <Button x:Name="FirewallButton" Content="Allow through firewall" Margin="0,0,8,0" />
                      <Button x:Name="TestReachButton" Content="Test again" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnDefinitions="230,16,*" Margin="0,14,0,0">
                  <Border Classes="card" Padding="12">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" Classes="label" Text="PLAYERS ONLINE" Margin="6,0,0,8" />
                      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                        <Button x:Name="KickButton" Content="Kick" Classes="danger" />
                        <Button x:Name="BanButton" Content="Ban" Classes="danger" />
                      </StackPanel>
                      <Panel>
                        <ListBox x:Name="PlayersList" />
                        <TextBlock x:Name="NoPlayersText" Classes="hint" Text="No one online yet" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </DockPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="card" Padding="12">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Top" Classes="label" Text="SERVER LOG" Margin="6,0,0,8" />
                      <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                               FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" BorderThickness="0" />
                    </DockPanel>
                  </Border>
                </Grid>
              </Grid>
            </Panel>
          </TabItem>

          <!-- ================= SETUP ================= -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="M4,7 H13 M17,7 H20 M15,4.5 V9.5 M4,17 H7 M11,17 H20 M9,14.5 V19.5" />
                <TextBlock Classes="navlabel" Text="Setup" />
              </StackPanel>
            </TabItem.Header>

            <ScrollViewer AllowAutoHide="False">
              <StackPanel Spacing="16" Margin="6,14,10,8">
                <StackPanel Spacing="2" Margin="2,0,0,0">
                  <TextBlock Text="Setup" Classes="title" />
                  <TextBlock Classes="hint" Text="Where the game is and what's installed. PLAY does all of this for you; these are for fixing things by hand." />
                </StackPanel>

                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="SUBNAUTICA FOLDER" />
                    <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                      <TextBox x:Name="GameDirBox" Watermark="Not set yet: Search my PC or Browse" />
                      <Button Grid.Column="2" x:Name="SearchButton" Content="Search my PC" />
                      <Button Grid.Column="4" x:Name="BrowseButton" Content="Browse..." />
                    </Grid>
                    <TextBlock Classes="hint" Text="Tip: in Steam, right-click Subnautica › Manage › Browse local files, and copy that folder's address here. Or start the game once while this window is open and it finds it by itself." />
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="INSTALLED" />
                    <TextBlock x:Name="GameStatus" />
                    <TextBlock x:Name="BepStatus" />
                    <TextBlock x:Name="ModStatus" />
                    <TextBlock x:Name="OptimizerStatus" />
                    <TextBlock x:Name="NautilusStatus" />
                    <TextBlock x:Name="InstallHint" Classes="hint" Text="Set the game folder first." />
                    <WrapPanel Margin="0,4,0,0">
                      <Button x:Name="InstallBepButton" Content="Install BepInEx for me" Margin="0,0,8,8" />
                      <Button x:Name="InstallModButton" Content="Install / update mod" Margin="0,0,8,8" />
                      <Button x:Name="OpenFolderButton" Content="Open mod folder" Margin="0,0,8,8" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Linux / Steam Deck only: the game runs in Proton, which needs one launch option for mods -->
                <Border Classes="card" x:Name="LinuxCard" IsVisible="False">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="LINUX / STEAM DECK" />
                    <TextBlock Classes="hint" Text="Subnautica runs through Proton here. For mods to load, set this once in Steam: right-click Subnautica › Properties › Launch options." />
                    <Grid ColumnDefinitions="*,8,Auto">
                      <TextBox x:Name="LaunchOptionBox" IsReadOnly="True" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" />
                      <Button Grid.Column="2" x:Name="CopyLaunchOptionButton" Content="Copy" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="FRIENDS ON DIFFERENT WIFI" />
                    <TextBlock Classes="hint" Text="The host's launcher asks the router to open the port by itself (UPnP). Most home routers allow it." />
                    <TextBlock Classes="hint" Text="If the Server page says it couldn't: turn on UPnP in the router, forward the port by hand, or have everyone install Radmin VPN / Tailscale and join with the host's VPN IP." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          </TabControl>

          <!-- top bar around the tabs: version on the left (drag area), minimize / close on the right -->
          <Border Grid.Row="0" x:Name="DragBar" Background="Transparent" HorizontalAlignment="Left" Width="220" Height="52" VerticalAlignment="Top">
            <TextBlock x:Name="VersionText" Classes="hint" VerticalAlignment="Center" Margin="6,0,0,0" />
          </Border>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,2,0">
            <Button x:Name="MinButton" Classes="chrome" ToolTip.Tip="Minimize"><Path Data="M2,6 H10" /></Button>
            <Button x:Name="CloseButton" Classes="chrome close" ToolTip.Tip="Close"><Path Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5" /></Button>
          </StackPanel>

          <!-- status line -->
          <Border Grid.Row="2" Padding="6,8,6,0" BorderBrush="#2A5A9A" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
    </Border>

    <!-- handle: the white shell flares out at the top and bottom and wraps over the blue frame (drag it to move the window) -->
    <Viewbox x:Name="Handle" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,4,0,4" Cursor="SizeAll">
      <Canvas Width="240" Height="700">
        <Path Data="M80,6 C140,6 210,16 210,66 C210,116 180,146 162,196 C151,236 148,300 148,350 C148,400 151,464 162,504 C180,554 210,584 210,634 C210,684 140,694 80,694 C34,694 10,668 10,620 L10,80 C10,32 34,6 80,6 Z"
              Stroke="#8994A0" StrokeThickness="1.5">
          <Path.Fill>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#C3CCD4" />
              <GradientStop Offset="0.22" Color="#FFFFFF" />
              <GradientStop Offset="0.55" Color="#EEF2F5" />
              <GradientStop Offset="0.85" Color="#D2D9E0" />
              <GradientStop Offset="1" Color="#A9B4BE" />
            </LinearGradientBrush>
          </Path.Fill>
          <Path.Effect>
            <DropShadowEffect OffsetX="5" OffsetY="0" BlurRadius="16" Color="#000814" Opacity="0.6" />
          </Path.Effect>
        </Path>
        <!-- a soft shine down the shell -->
        <Path Data="M40,40 C30,120 30,580 40,660" Stroke="#FFFFFF" StrokeThickness="3" Opacity="0.7" StrokeLineCap="Round" />
        <!-- rubber grip: dimpled like a golf ball, finger bumps on the outside edge -->
        <Rectangle Canvas.Left="18" Canvas.Top="213" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="15" Canvas.Top="247" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="13" Canvas.Top="281" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="12" Canvas.Top="315" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="12" Canvas.Top="349" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="13" Canvas.Top="383" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="14" Canvas.Top="417" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="17" Canvas.Top="451" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Rectangle Canvas.Left="20" Canvas.Top="485" Width="40" Height="26" RadiusX="13" RadiusY="13" Fill="{StaticResource BumpBrush}" Stroke="#0A0C0F" StrokeThickness="1.2" />
        <Path Data="M70,92 C106,92 118,180 118,350 C118,520 106,608 70,608 C38,608 26,520 26,350 C26,180 38,92 70,92 Z" Stroke="#0A0C0F" StrokeThickness="1.5">
          <Path.Fill>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#14171B" />
              <GradientStop Offset="0.4" Color="#2A313A" />
              <GradientStop Offset="1" Color="#5A6878" />
            </LinearGradientBrush>
          </Path.Fill>
        </Path>
        <Canvas Width="130" Height="700" Clip="M70,92 C106,92 118,180 118,350 C118,520 106,608 70,608 C38,608 26,520 26,350 C26,180 38,92 70,92 Z">
          <Ellipse Canvas.Left="57.5" Canvas.Top="110.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="71.5" Canvas.Top="110.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="50.5" Canvas.Top="124.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="64.5" Canvas.Top="124.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="78.5" Canvas.Top="124.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="43.5" Canvas.Top="138.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="57.5" Canvas.Top="138.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="71.5" Canvas.Top="138.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="85.5" Canvas.Top="138.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="50.5" Canvas.Top="152.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="64.5" Canvas.Top="152.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="78.5" Canvas.Top="152.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="92.5" Canvas.Top="152.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="43.5" Canvas.Top="166.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="57.5" Canvas.Top="166.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="71.5" Canvas.Top="166.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="85.5" Canvas.Top="166.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="36.5" Canvas.Top="180.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="50.5" Canvas.Top="180.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="64.5" Canvas.Top="180.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="78.5" Canvas.Top="180.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="92.5" Canvas.Top="180.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="43.5" Canvas.Top="194.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="57.5" Canvas.Top="194.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="71.5" Canvas.Top="194.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="85.5" Canvas.Top="194.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
          <Ellipse Canvas.Left="99.5" Canvas.Top="194.5" Width="11" Height="11" Fill="{StaticResource DimpleBrush}" />
