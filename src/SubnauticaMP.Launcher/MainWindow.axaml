<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SubnauticaMP.Launcher.MainWindow"
        Title="Subnautica Multiplayer"
        Icon="/Assets/icon.ico"
        Width="1120" Height="690" CanResize="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        WindowStartupLocation="CenterScreen">

  <!-- The window IS the PDA: a white handle with a rubber grip on the left (drag it to move the window),
       a glowing blue frame and the dark screen. Everything happens on the screen. -->
  <Grid>
    <!-- blue frame -->
    <Border Margin="128,16,16,16" CornerRadius="42" Padding="20" BoxShadow="0 0 26 3 #992F7BFF">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#4AA6FF" />
          <GradientStop Offset="0.5" Color="#1767EA" />
          <GradientStop Offset="1" Color="#0C4FCB" />
        </LinearGradientBrush>
      </Border.Background>

      <!-- screen -->
      <Border CornerRadius="24" Background="#020A1A" BorderBrush="#86C8FF" BorderThickness="1.5"
              BoxShadow="inset 0 0 44 6 #8C2F7BFF" Padding="20,12,20,12" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <TabControl Grid.RowSpan="2" x:Name="Tabs" Classes="pda">

            <!-- ================= HOME ================= -->
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="M4,11 L12,4 L20,11 V20 H4 Z M10,20 V14.5 H14 V20" />
                  <TextBlock Classes="navlabel" Text="Home" />
                </StackPanel>
              </TabItem.Header>

              <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="6,14,6,4">
                <StackPanel Spacing="2" Margin="2,0,0,14">
                  <TextBlock Text="Subnautica Multiplayer" Classes="title" />
                  <TextBlock Classes="hint" Text="Play the whole game together with your friends." />
                </StackPanel>

                <Grid Grid.Row="1">
                  <Border Classes="card" Padding="8">
                    <StackPanel Spacing="6">
                      <Border x:Name="GameChip" Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Classes="bubble"><Path Classes="glyph" Data="M3,8 H21 V18 H3 Z M7,12 H10 M8.5,10.5 V13.5 M15,12 H15.5 M17.5,13 H18" /></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="2">
                            <TextBlock x:Name="GameChipText" Classes="rowtitle" />
                            <TextBlock x:Name="PlayGameStatus" Classes="rowdetail" />
                          </StackPanel>
                          <Button Grid.Column="2" x:Name="PlayBrowseButton" Content="Browse..." VerticalAlignment="Center" Margin="0,0,12,0" />
                          <Ellipse Grid.Column="3" Classes="dot" />
                        </Grid>
                      </Border>
                      <Border x:Name="ModChip" Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="bubble"><Path Classes="glyph" Data="M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M4,7.5 L12,12 L20,7.5 M12,12 V21" /></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="2">
                            <TextBlock x:Name="ModChipText" Classes="rowtitle" />
                            <TextBlock Classes="rowdetail" Text="BepInEx and the mod, in the game folder" />
                          </StackPanel>
                          <Ellipse Grid.Column="2" Classes="dot" />
                        </Grid>
                      </Border>
                      <Border x:Name="ServerChip" Classes="row">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Classes="bubble"><Path Classes="glyph" Data="M4,4.5 H20 V10.5 H4 Z M4,13.5 H20 V19.5 H4 Z M7.5,7.5 H8.5 M7.5,16.5 H8.5" /></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" Spacing="2">
                            <TextBlock x:Name="ServerChipText" Classes="rowtitle" />
                            <TextBlock Classes="rowdetail" Text="Host a world here on the Server tab, or join one in the game" />
                          </StackPanel>
                          <Ellipse Grid.Column="2" Classes="dot" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>

                </Grid>

                <Grid Grid.Row="3" ColumnDefinitions="*,20,300" Margin="0,14,0,0">
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="label" Text="HOW TO PLAY" />
                      <TextBlock Classes="step" Text="Hit PLAY. The game opens with the mod installed." />
                      <TextBlock Classes="step" Text="In the main menu click Multiplayer, then host a world or add a friend's join code." />
                      <TextBlock Classes="step" Text="In game: Esc › Multiplayer or F8 for chat and players. Hold G for emotes." />
                    </StackPanel>
                  </Border>

                  <Grid Grid.Column="2" RowDefinitions="*,Auto">
                    <Border CornerRadius="16" Margin="3" BoxShadow="0 0 30 2 #992F7BFF" Background="#1767EA" />
                    <Button x:Name="PlayButton" Classes="primary play" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="96">
                      <TextBlock x:Name="PlayButtonText" Text="PLAY" LetterSpacing="8" Margin="8,0,0,0" />
                    </Button>
                    <TextBlock Grid.Row="1" x:Name="PlayCaption" Classes="hint" TextAlignment="Center" Margin="0,8,0,0"
                               Text="Installs the mod, then starts the game" />
                  </Grid>
                </Grid>
              </Grid>
            </TabItem>

          <!-- ================= SERVER ================= -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="M4,4.5 H20 V10.5 H4 Z M4,13.5 H20 V19.5 H4 Z M7.5,7.5 H8.5 M7.5,16.5 H8.5" />
                <TextBlock Classes="navlabel" Text="Server" />
              </StackPanel>
            </TabItem.Header>

            <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="6,14,6,4">
              <StackPanel Spacing="2" Margin="2,0,0,12">
                <TextBlock Text="Server" Classes="title" />
                <TextBlock Classes="hint" Text="Runs the world on this PC. In the game it shows up as 'Launcher server'." />
              </StackPanel>

              <Border Grid.Row="1" Classes="card">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="2*,14,*,14,*,14,96">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="WORLD NAME" />
                    <TextBox x:Name="WorldBox" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="label" Text="GAME MODE" />
                    <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="6">
                    <TextBlock Classes="label" Text="PASSWORD" />
                    <TextBox x:Name="HostPasswordBox" PasswordChar="•" Watermark="optional" />
                  </StackPanel>
                  <StackPanel Grid.Column="6" Spacing="6">
                    <TextBlock Classes="label" Text="PORT" />
                    <TextBox x:Name="PortBox" />
                  </StackPanel>

                  <Grid Grid.Row="1" Grid.ColumnSpan="7" ColumnDefinitions="*,18,Auto" Margin="0,16,0,0">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock x:Name="WorldSummary" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock x:Name="ModeHint" Classes="hint" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ServerButton" Classes="primary" Content="START SERVER" MinWidth="200" Height="48" FontSize="15" />
                  </Grid>
                </Grid>
              </Border>

              <!-- not running: what happens next -->
              <Border Grid.Row="2" x:Name="ServerIdleCard" Classes="card" Margin="0,16,0,0" Padding="18,12">
                <TextBlock Classes="hint" Text="Start the server to get join codes for your friends. They paste one in the game's Multiplayer › Add server." />
              </Border>

              <!-- running: the join codes -->
              <Border Grid.Row="2" Classes="card" Margin="0,16,0,0" x:Name="CodesCard" IsVisible="False">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto,28,*,Auto">
                    <StackPanel>
                      <TextBlock Classes="label" Text="JOIN CODE  ·  INTERNET" />
                      <TextBlock x:Name="InternetCodeText" Classes="code" Text="..." />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="CopyInternetButton" Content="Copy" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Width="1" Background="#1E5A6E" Margin="13,4" />
                    <StackPanel Grid.Column="3">
                      <TextBlock Classes="label" Text="JOIN CODE  ·  SAME WIFI" />
                      <TextBlock x:Name="LanCodeText" Classes="code" FontSize="22" Margin="0,5,0,0" Text="..." />
                    </StackPanel>
                    <Button Grid.Column="4" x:Name="CopyLanButton" Content="Copy" VerticalAlignment="Center" />
                  </Grid>
                  <Border Classes="inset">
                    <StackPanel Spacing="5">
                      <TextBlock x:Name="LobbyText" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                      <TextBlock x:Name="RouterText" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock x:Name="ReachText" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <WrapPanel>
                    <Button x:Name="FirewallButton" Content="Allow through firewall" Margin="0,0,8,0" />
                    <Button x:Name="TestReachButton" Content="Test again" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Grid Grid.Row="3" ColumnDefinitions="230,16,*" Margin="0,16,0,0">
                <Border Classes="card" Padding="12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="label" Text="PLAYERS ONLINE" Margin="6,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                      <Button x:Name="KickButton" Content="Kick" Classes="danger" />
                      <Button x:Name="BanButton" Content="Ban" Classes="danger" />
                    </StackPanel>
                    <Panel>
                      <ListBox x:Name="PlayersList" />
                      <TextBlock x:Name="NoPlayersText" Classes="hint" Text="No one online yet" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </DockPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="label" Text="SERVER LOG" Margin="6,0,0,8" />
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Watermark="Start the server to see its log here."
                             FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" BorderThickness="0" />
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>
          </TabItem>

          <!-- ================= SETUP ================= -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="M4,7 H13 M17,7 H20 M15,4.5 V9.5 M4,17 H7 M11,17 H20 M9,14.5 V19.5" />
                <TextBlock Classes="navlabel" Text="Setup" />
              </StackPanel>
            </TabItem.Header>

            <ScrollViewer AllowAutoHide="False">
              <StackPanel Spacing="16" Margin="6,14,10,8">
                <StackPanel Spacing="2" Margin="2,0,0,0">
                  <TextBlock Text="Setup" Classes="title" />
                  <TextBlock Classes="hint" Text="Where the game is and what's installed. PLAY does all of this for you; these are for fixing things by hand." />
                </StackPanel>

                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="SUBNAUTICA FOLDER" />
                    <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                      <TextBox x:Name="GameDirBox" Watermark="Not set yet: Search my PC or Browse" />
                      <Button Grid.Column="2" x:Name="SearchButton" Content="Search my PC" />
                      <Button Grid.Column="4" x:Name="BrowseButton" Content="Browse..." />
                    </Grid>
                    <TextBlock Classes="hint" Text="Tip: in Steam, right-click Subnautica › Manage › Browse local files, and copy that folder's address here. Or start the game once while this window is open and it finds it by itself." />
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="INSTALLED" />
                    <TextBlock x:Name="GameStatus" />
                    <TextBlock x:Name="BepStatus" />
                    <TextBlock x:Name="ModStatus" />
                    <TextBlock x:Name="InstallHint" Classes="hint" Text="Set the game folder first." />
                    <WrapPanel Margin="0,4,0,0">
                      <Button x:Name="InstallBepButton" Content="Install BepInEx for me" Margin="0,0,8,8" />
                      <Button x:Name="InstallModButton" Content="Install / update mod" Margin="0,0,8,8" />
                      <Button x:Name="OpenFolderButton" Content="Open mod folder" Margin="0,0,8,8" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <!-- Linux / Steam Deck only: the game runs in Proton, which needs one launch option for mods -->
                <Border Classes="card" x:Name="LinuxCard" IsVisible="False">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="LINUX / STEAM DECK" />
                    <TextBlock Classes="hint" Text="Subnautica runs through Proton here. For mods to load, set this once in Steam: right-click Subnautica › Properties › Launch options." />
                    <Grid ColumnDefinitions="*,8,Auto">
                      <TextBox x:Name="LaunchOptionBox" IsReadOnly="True" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" />
                      <Button Grid.Column="2" x:Name="CopyLaunchOptionButton" Content="Copy" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="FRIENDS ON DIFFERENT WIFI" />
                    <TextBlock Classes="hint" Text="The host's launcher asks the router to open the port by itself (UPnP). Most home routers allow it." />
                    <TextBlock Classes="hint" Text="If the Server page says it couldn't: turn on UPnP in the router, forward the port by hand, or have everyone install Radmin VPN / Tailscale and join with the host's VPN IP." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          </TabControl>

          <!-- top bar around the tabs: version on the left (drag area), minimize / close on the right -->
          <Border Grid.Row="0" x:Name="DragBar" Background="Transparent" HorizontalAlignment="Left" Width="220" Height="52" VerticalAlignment="Top">
            <TextBlock x:Name="VersionText" Classes="hint" VerticalAlignment="Center" Margin="6,0,0,0" />
          </Border>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,2,0">
            <Button x:Name="MinButton" Classes="chrome" ToolTip.Tip="Minimize"><Path Data="M2,6 H10" /></Button>
            <Button x:Name="CloseButton" Classes="chrome close" ToolTip.Tip="Close"><Path Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5" /></Button>
          </StackPanel>

          <!-- status line -->
          <Border Grid.Row="2" Padding="6,8,6,0" BorderBrush="#2A5A9A" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
    </Border>

    <!-- the little light on the frame -->
    <Ellipse Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="196,30,0,0" Stroke="#CFE8FF" StrokeThickness="2">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Offset="0" Color="#FFFFFF" />
          <GradientStop Offset="0.45" Color="#7FC0FF" />
          <GradientStop Offset="1" Color="#1767EA" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- handle (drag to move the window) -->
    <Viewbox x:Name="Handle" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,4,0,4" Cursor="SizeAll">
      <Canvas Width="170" Height="700">
        <!-- white body with a waist that runs into the blue frame -->
        <Path Data="M74,6 C134,6 168,32 168,96 C168,170 140,230 140,350 C140,470 168,530 168,604 C168,668 134,694 74,694 C32,694 10,668 10,620 L10,80 C10,32 32,6 74,6 Z" Stroke="#8E99A3" StrokeThickness="1.5">
          <Path.Fill>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Offset="0" Color="#C9D1D8" />
              <GradientStop Offset="0.45" Color="#FFFFFF" />
              <GradientStop Offset="0.8" Color="#E6ECF1" />
              <GradientStop Offset="1" Color="#AEB8C1" />
            </LinearGradientBrush>
          </Path.Fill>
        </Path>
        <!-- rubber grip with ridges on the outside -->
        <Ellipse Canvas.Left="1" Canvas.Top="150" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="190" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="230" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="270" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="310" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="350" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="390" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="430" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="470" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="510" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Ellipse Canvas.Left="1" Canvas.Top="550" Width="14" Height="24" Fill="#30353A" Stroke="#15181B" StrokeThickness="1" />
        <Path Data="M46,96 C80,96 88,180 88,350 C88,520 80,604 46,604 C18,604 8,520 8,350 C8,180 18,96 46,96 Z" Fill="#2A2E33" Stroke="#15181B" StrokeThickness="1.5" />
        <Ellipse Canvas.Left="44" Canvas.Top="125" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="38" Canvas.Top="138" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="50" Canvas.Top="138" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="32" Canvas.Top="151" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="44" Canvas.Top="151" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="56" Canvas.Top="151" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="26" Canvas.Top="164" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="38" Canvas.Top="164" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="50" Canvas.Top="164" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="62" Canvas.Top="164" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="32" Canvas.Top="177" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="44" Canvas.Top="177" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="56" Canvas.Top="177" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="26" Canvas.Top="190" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="38" Canvas.Top="190" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="50" Canvas.Top="190" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="62" Canvas.Top="190" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="20" Canvas.Top="203" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="32" Canvas.Top="203" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="44" Canvas.Top="203" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="56" Canvas.Top="203" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="68" Canvas.Top="203" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="26" Canvas.Top="216" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="38" Canvas.Top="216" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="50" Canvas.Top="216" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="62" Canvas.Top="216" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="20" Canvas.Top="229" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="32" Canvas.Top="229" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="44" Canvas.Top="229" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="56" Canvas.Top="229" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="68" Canvas.Top="229" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="26" Canvas.Top="242" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="38" Canvas.Top="242" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="50" Canvas.Top="242" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="62" Canvas.Top="242" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="20" Canvas.Top="255" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="32" Canvas.Top="255" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
        <Ellipse Canvas.Left="44" Canvas.Top="255" Width="8" Height="8" Fill="#454B52" Stroke="#1C2024" StrokeThickness="1" />
