<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The mod itself (runs inside the game through BepInEx 5).
    It talks to Subnautica's code by name at runtime, so it doesn't need the game to build.
    If GameDir points at your install, it builds against the real BepInEx/Unity DLLs there
    and copies itself into BepInEx\plugins. Otherwise it builds against reference copies.
      dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Subnautica"
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SubnauticaMP</AssemblyName>
    <RootNamespace>SubnauticaMP</RootNamespace>
    <Version>0.18.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Subnautica</GameDir>
    <ManagedDir>$(GameDir)\Subnautica_Data\Managed</ManagedDir>
    <UseGameDlls Condition="Exists('$(GameDir)\BepInEx\core\BepInEx.dll')">true</UseGameDlls>
  </PropertyGroup>

  <!-- Shared networking code is compiled straight in so the mod is a single DLL. -->
  <ItemGroup>
    <Compile Include="..\SubnauticaMP.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- dance / emote animations (tools/emotes/make_emotes.py) -->
  <ItemGroup>
    <EmbeddedResource Include="Emotes.bin" LogicalName="SubnauticaMP.Emotes.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- router port forwarding (same library as Nitrox); Mono.Nat.dll ships next to SubnauticaMP.dll -->
    <PackageReference Include="Mono.Nat" Version="3.0.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameDlls)' == 'true'">
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(ManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>

  <!-- Nautilus (optional at runtime): always compiled against our small stand-in, never shipped. -->
  <ItemGroup>
    <ProjectReference Include="..\..\lib\Nautilus.Ref\Nautilus.Ref.csproj" Private="false" />
  </ItemGroup>

  <!-- No game here: compile against reference copies (never shipped, the game's own DLLs are used at runtime). -->
  <ItemGroup Condition="'$(UseGameDlls)' != 'true'">
    <ProjectReference Include="..\..\lib\BepInEx.Ref\BepInEx.Ref.csproj" Private="false" />
    <PackageReference Include="HarmonyX" Version="2.9.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(UseGameDlls)' == 'true'">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\SubnauticaMP" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Mono.Nat.dll" DestinationFolder="$(GameDir)\BepInEx\plugins\SubnauticaMP" />
  </Target>

</Project>
