<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds against YOUR Subnautica install (game DLLs can't be shipped in the repo).
    Set GameDir if the game isn't in the default Steam spot:
      dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Subnautica"
    Needs BepInEx 5 installed in the game folder first.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SubnauticaMP</AssemblyName>
    <RootNamespace>SubnauticaMP</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Subnautica</GameDir>
    <ManagedDir>$(GameDir)\Subnautica_Data\Managed</ManagedDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Shared networking code is compiled straight in so the mod is a single DLL. -->
  <ItemGroup>
    <Compile Include="..\SubnauticaMP.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
  </ItemGroup>

  <!-- Drops the built DLL straight into the game's plugin folder. -->
  <Target Name="CopyToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\SubnauticaMP" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\SubnauticaMP" />
  </Target>

</Project>
